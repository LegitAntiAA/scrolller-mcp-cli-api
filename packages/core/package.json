{
  "name": "scrolller-core",
  "version": "0.1.0",
  "description": "TypeScript API client for Scrolller (scrolller.com) — media discovery, feeds, search, comments, likes, collections",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "scrolller",
    "api",
    "client",
    "graphql",
    "downloader"
  ],
  "license": "MIT"
}
